diff --git a/ipaplatform/gentoo/paths.py b/ipaplatform/gentoo/paths.py
new file mode 100644
--- /dev/null
+++ b/ipaplatform/gentoo/paths.py
@@ -0,0 +1,25 @@
+"""Gentoo filesystem paths."""
+
+from __future__ import absolute_import
+
+from ipaplatform.base.paths import BasePathNamespace
+
+
+class GentooPathNamespace(BasePathNamespace):
+    BIN_HOSTNAMECTL = "/usr/bin/hostnamectl"
+    SYSTEMCTL = "/usr/bin/systemctl"
+
+    CHRONY_CONF = "/etc/chrony/chrony.conf"
+    OPENLDAP_LDAP_CONF = "/etc/openldap/ldap.conf"
+
+    OPENSSL_DIR = "/etc/ssl"
+    OPENSSL_CERTS_DIR = "/etc/ssl/certs"
+    OPENSSL_PRIVATE_DIR = "/etc/ssl/private"
+
+    CA_CERTIFICATES_BUNDLE_PEM = "/usr/local/share/ca-certificates/ipa-ca.crt"
+    CA_CERTIFICATES_DIR = "/usr/local/share/ca-certificates/ipa-ca"
+    IPA_P11_KIT = "/usr/local/share/ca-certificates/ipa.p11-kit"
+    UPDATE_CA_TRUST = "/usr/bin/update-ca-certificates"
+
+
+paths = GentooPathNamespace()
diff --git a/ipaplatform/gentoo/services.py b/ipaplatform/gentoo/services.py
new file mode 100644
--- /dev/null
+++ b/ipaplatform/gentoo/services.py
@@ -0,0 +1,19 @@
+"""Gentoo-specific systemd service support."""
+
+from __future__ import absolute_import
+
+from ipaplatform.redhat import services as redhat_services
+
+
+def gentoo_service_class_factory(name, api=None):
+    return redhat_services.redhat_service_class_factory(name, api)
+
+
+class GentooServices(redhat_services.RedHatServices):
+    def service_class_factory(self, name, api=None):
+        return gentoo_service_class_factory(name, api)
+
+
+timedate_services = redhat_services.timedate_services
+service = gentoo_service_class_factory
+knownservices = GentooServices()
