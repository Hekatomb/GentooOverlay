diff --git a/ipaplatform/gentoo/tasks.py b/ipaplatform/gentoo/tasks.py
new file mode 100644
--- /dev/null
+++ b/ipaplatform/gentoo/tasks.py
@@ -0,0 +1,33 @@
+"""Gentoo-specific system tasks."""
+
+from __future__ import absolute_import
+
+from pathlib import Path
+
+from ipaplatform.debian.tasks import DebianTaskNamespace
+from ipaplatform.paths import paths
+
+
+class GentooTaskNamespace(DebianTaskNamespace):
+    @staticmethod
+    def restore_pre_ipa_client_configuration(
+            fstore, statestore, was_sssd_installed, was_sssd_configured):
+        # Gentoo pambase owns the PAM configuration. ipa-client-install
+        # therefore has nothing to restore here.
+        return True
+
+    @staticmethod
+    def modify_nsswitch_pam_stack(
+            sssd, mkhomedir, statestore, sudo=True, subid=False):
+        # PAM integration is provided by sys-auth/pambase[sssd].
+        # Do not invoke Debian's pam-auth-update.
+        return True
+
+    def platform_insert_ca_certs(self, ca_certs):
+        Path(paths.CA_CERTIFICATES_DIR).parent.mkdir(
+            mode=0o755, parents=True, exist_ok=True
+        )
+        return super().platform_insert_ca_certs(ca_certs)
+
+
+tasks = GentooTaskNamespace()
